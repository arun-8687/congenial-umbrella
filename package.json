{
  "name": "copilot-bot-platform",
  "version": "0.1.0",
  "description": "Enterprise bot platform (bots, skills, connectors, inter-bot messaging) on the GitHub Copilot SDK",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "copilot-bots": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.23",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
